<mxfile host="Electron">
  <diagram name="Page-1" id="0Wb3y-JIdYabe1NltyKD">
    <mxGraphModel dx="6380" dy="4120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho\nskinparam class {\n    BorderThickness 1.5\n    ArrowColor #424242\n    FontColor #212121\n}\n\n&#39; ===== USERS &amp; KYC (Blue) =====\nentity users #E3F2FD {\n    * user_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * phone_number : VARCHAR(15) &lt;&lt;UQ&gt;&gt;\n    * pin_hash : VARCHAR(255)\n    * failed_pin_attempts : INT &lt;&lt;DF 0&gt;&gt;\n    * pin_locked_until : TIMESTAMP\n    * last_pin_change_at : TIMESTAMP\n    * first_name : VARCHAR(100)\n    * last_name : VARCHAR(100)\n    * national_id : VARCHAR(50) &lt;&lt;UQ&gt;&gt;\n    * email : VARCHAR(255)\n    * user_type : ENUM(&#39;CUSTOMER&#39;,&#39;AGENT&#39;,&#39;MERCHANT&#39;,&#39;ADMIN&#39;)\n    * status : ENUM(&#39;ACTIVE&#39;,&#39;SUSPENDED&#39;,&#39;CLOSED&#39;)\n    * deleted_at : TIMESTAMP\n    * created_at : TIMESTAMP\n    * updated_at : TIMESTAMP\n}\n\nentity kyc_verifications #E3F2FD {\n    * kyc_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * user_id : UUID &lt;&lt;FK&gt;&gt;\n    * kyc_level : INT\n    * id_document_type : ENUM(&#39;NATIONAL_ID&#39;,&#39;PASSPORT&#39;,&#39;DRIVERS_LICENSE&#39;)\n    * id_document_number : VARCHAR(50)\n    * id_document_path : VARCHAR(500)\n    * selfie_path : VARCHAR(500)\n    * proof_of_residence_path : VARCHAR(500)\n    * verified_by : UUID &lt;&lt;FK&gt;&gt;\n    * verification_status : ENUM(&#39;PENDING&#39;,&#39;APPROVED&#39;,&#39;REJECTED&#39;)\n    * rejection_reason : TEXT\n    * verified_at : TIMESTAMP\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== SECURITY &amp; SESSIONS (Indigo) =====\nentity user_sessions #E8EAF6 {\n    * session_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * user_id : UUID &lt;&lt;FK&gt;&gt;\n    * device_fingerprint : VARCHAR(255)\n    * ip_address : INET\n    * user_agent : TEXT\n    * auth_token_hash : VARCHAR(255)\n    * last_active_at : TIMESTAMP\n    * expires_at : TIMESTAMP\n    * revoked_at : TIMESTAMP\n    * created_at : TIMESTAMP\n}\n\nentity security_events #E8EAF6 {\n    * event_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * user_id : UUID &lt;&lt;FK&gt;&gt;\n    * event_type : ENUM(&#39;LOGIN&#39;,&#39;LOGOUT&#39;,&#39;PIN_CHANGE&#39;,&#39;FAILED_PIN&#39;,&#39;DEVICE_CHANGE&#39;,&#39;SUSPICIOUS_ACTIVITY&#39;)\n    * ip_address : INET\n    * device_fingerprint : VARCHAR(255)\n    * risk_score : DECIMAL(3,2)\n    * blocked : BOOLEAN\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== CURRENCIES (Gray) =====\nentity currencies #F5F5F5 {\n    * currency_code : CHAR(3) &lt;&lt;PK&gt;&gt;\n    --\n    * currency_name : VARCHAR(100)\n    * symbol : VARCHAR(10)\n    * decimal_places : INT\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== WALLETS (Green) =====\nentity wallets #E8F5E9 {\n    * wallet_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * user_id : UUID &lt;&lt;FK&gt;&gt;\n    * wallet_type : ENUM(&#39;CUSTOMER&#39;,&#39;AGENT_FLOAT&#39;,&#39;MERCHANT&#39;,&#39;SYSTEM&#39;)\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * balance : DECIMAL(24,6)\n    * available_balance : DECIMAL(24,6)\n    * held_balance : DECIMAL(24,6)\n    * daily_limit : DECIMAL(24,6)\n    * monthly_limit : DECIMAL(24,6)\n    * is_active : BOOLEAN\n    * deleted_at : TIMESTAMP\n    * opened_at : TIMESTAMP\n    * last_transaction_at : TIMESTAMP\n    --\n    &lt;&lt;UQ&gt;&gt; (user_id, currency_code, wallet_type) WHERE deleted_at IS NULL\n}\n\nentity wallet_balance_snapshots #E8F5E9 {\n    * snapshot_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * wallet_id : UUID &lt;&lt;FK&gt;&gt;\n    * balance : DECIMAL(24,6)\n    * available_balance : DECIMAL(24,6)\n    * held_balance : DECIMAL(24,6)\n    * snapshot_date : DATE\n    * created_at : TIMESTAMP\n    --\n    &lt;&lt;UQ&gt;&gt; (wallet_id, snapshot_date)\n}\n\n&#39; ===== TRANSACTIONS (Red) =====\nentity transactions #FFEBEE {\n    * transaction_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * reference_number : VARCHAR(50) &lt;&lt;UQ&gt;&gt;\n    * idempotency_key : VARCHAR(100) &lt;&lt;UQ&gt;&gt;\n    * transaction_type : ENUM(&#39;DEPOSIT&#39;,&#39;WITHDRAWAL&#39;,&#39;TRANSFER&#39;,&#39;PAYMENT&#39;,&#39;AIRTIME&#39;,&#39;BILL_PAY&#39;,&#39;CASH_IN&#39;,&#39;CASH_OUT&#39;,&#39;REFUND&#39;,&#39;REVERSAL&#39;)\n    * status : ENUM(&#39;PENDING&#39;,&#39;COMPLETED&#39;,&#39;FAILED&#39;,&#39;REVERSED&#39;,&#39;CANCELLED&#39;)\n    * amount : DECIMAL(24,6)\n    * fee_amount : DECIMAL(24,6) &lt;&lt;DF 0&gt;&gt;\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * sender_wallet_id : UUID &lt;&lt;FK&gt;&gt;\n    * receiver_wallet_id : UUID &lt;&lt;FK&gt;&gt;\n    * parent_transaction_id : UUID &lt;&lt;FK&gt;&gt;\n    * agent_id : UUID &lt;&lt;FK&gt;&gt;\n    * merchant_id : UUID &lt;&lt;FK&gt;&gt;\n    * source_channel : ENUM(&#39;MOBILE_APP&#39;,&#39;USSD&#39;,&#39;API&#39;,&#39;WEB&#39;,&#39;AGENT_APP&#39;)\n    * description : TEXT\n    * metadata : JSONB\n    * external_reference : VARCHAR(100)\n    * completed_at : TIMESTAMP\n    * created_at : TIMESTAMP\n}\n\nentity transaction_fees #FFEBEE {\n    * fee_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * transaction_id : UUID &lt;&lt;FK&gt;&gt;\n    * fee_type : ENUM(&#39;PLATFORM&#39;,&#39;AGENT&#39;,&#39;BANK&#39;,&#39;TAX&#39;,&#39;PROCESSING&#39;)\n    * amount : DECIMAL(24,6)\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * description : TEXT\n    * created_at : TIMESTAMP\n}\n\nentity transaction_failures #F3E5F5 {\n    * failure_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * transaction_id : UUID &lt;&lt;FK&gt;&gt;\n    * failure_code : VARCHAR(50)\n    * failure_reason : TEXT\n    * failure_stage : ENUM(&#39;VALIDATION&#39;,&#39;AUTHORIZATION&#39;,&#39;SETTLEMENT&#39;,&#39;NOTIFICATION&#39;)\n    * retry_count : INT\n    * is_resolved : BOOLEAN\n    * resolved_at : TIMESTAMP\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== DISPUTES (Pink) =====\nentity disputes #FCE4EC {\n    * dispute_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * transaction_id : UUID &lt;&lt;FK&gt;&gt;\n    * raised_by_user_id : UUID &lt;&lt;FK&gt;&gt;\n    * reason : TEXT\n    * status : ENUM(&#39;OPEN&#39;,&#39;UNDER_REVIEW&#39;,&#39;RESOLVED&#39;,&#39;REJECTED&#39;,&#39;ESCALATED&#39;)\n    * resolution_notes : TEXT\n    * resolution_amount : DECIMAL(24,6)\n    * resolved_by : UUID &lt;&lt;FK&gt;&gt;\n    * resolved_at : TIMESTAMP\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== LEDGER (Cyan) =====\nentity ledger_entries #E0F7FA {\n    * entry_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * transaction_id : UUID &lt;&lt;FK&gt;&gt;\n    * wallet_id : UUID &lt;&lt;FK&gt;&gt;\n    * entry_type : ENUM(&#39;DEBIT&#39;,&#39;CREDIT&#39;)\n    * amount : DECIMAL(24,6)\n    * running_balance : DECIMAL(24,6)\n    * account_type : ENUM(&#39;ASSET&#39;,&#39;LIABILITY&#39;,&#39;REVENUE&#39;,&#39;EXPENSE&#39;)\n    * description : TEXT\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== MERCHANTS (Teal) =====\nentity merchants #E0F2F1 {\n    * merchant_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * user_id : UUID &lt;&lt;FK&gt;&gt; &lt;&lt;UQ&gt;&gt;\n    * business_name : VARCHAR(200)\n    * business_registration : VARCHAR(100)\n    * mcc_code : VARCHAR(4)\n    * settlement_wallet_id : UUID &lt;&lt;FK&gt;&gt;\n    * webhook_url : VARCHAR(500)\n    * webhook_secret : VARCHAR(255)\n    * settlement_frequency : ENUM(&#39;DAILY&#39;,&#39;WEEKLY&#39;,&#39;MONTHLY&#39;,&#39;INSTANT&#39;)\n    * status : ENUM(&#39;ACTIVE&#39;,&#39;SUSPENDED&#39;,&#39;TERMINATED&#39;)\n    * deleted_at : TIMESTAMP\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== AGENTS &amp; FLOAT (Orange) =====\nentity agents #FFF3E0 {\n    * agent_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * user_id : UUID &lt;&lt;FK&gt;&gt; &lt;&lt;UQ&gt;&gt;\n    * agent_code : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * business_name : VARCHAR(200)\n    * business_registration : VARCHAR(100)\n    * territory : VARCHAR(100)\n    * commission_rate : DECIMAL(5,4)\n    * float_limit : DECIMAL(24,6)\n    * current_float : DECIMAL(24,6)\n    * supervisor_id : UUID &lt;&lt;FK&gt;&gt;\n    * status : ENUM(&#39;ACTIVE&#39;,&#39;SUSPENDED&#39;,&#39;TERMINATED&#39;)\n    * deleted_at : TIMESTAMP\n    * onboarded_at : TIMESTAMP\n}\n\nentity agent_float_balances #FFF3E0 {\n    * float_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * agent_id : UUID &lt;&lt;FK&gt;&gt;\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * opening_float : DECIMAL(24,6)\n    * closing_float : DECIMAL(24,6)\n    * cash_in_total : DECIMAL(24,6)\n    * cash_out_total : DECIMAL(24,6)\n    * date : DATE\n    * reconciled_at : TIMESTAMP\n}\n\nentity commissions #FFF3E0 {\n    * commission_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * transaction_id : UUID &lt;&lt;FK&gt;&gt;\n    * agent_id : UUID &lt;&lt;FK&gt;&gt;\n    * commission_type : ENUM(&#39;CASH_IN&#39;,&#39;CASH_OUT&#39;,&#39;BILL_PAYMENT&#39;,&#39;AIRTIME&#39;,&#39;TRANSFER&#39;)\n    * commission_amount : DECIMAL(24,6)\n    * commission_rate : DECIMAL(5,4)\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * status : ENUM(&#39;PENDING&#39;,&#39;PAID&#39;,&#39;WITHHELD&#39;)\n    * paid_at : TIMESTAMP\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== SCHEDULED PAYMENTS (Yellow) =====\nentity scheduled_payments #FFFDE7 {\n    * schedule_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * user_id : UUID &lt;&lt;FK&gt;&gt;\n    * wallet_id : UUID &lt;&lt;FK&gt;&gt;\n    * recipient_wallet_id : UUID &lt;&lt;FK&gt;&gt;\n    * amount : DECIMAL(24,6)\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * frequency : ENUM(&#39;ONCE&#39;,&#39;DAILY&#39;,&#39;WEEKLY&#39;,&#39;MONTHLY&#39;)\n    * next_execution_at : TIMESTAMP\n    * end_date : TIMESTAMP\n    * total_executions : INT\n    * max_executions : INT\n    * status : ENUM(&#39;ACTIVE&#39;,&#39;PAUSED&#39;,&#39;COMPLETED&#39;,&#39;CANCELLED&#39;)\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== COMPLIANCE / AML (Deep Purple) =====\nentity aml_screenings #EDE7F6 {\n    * screening_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * user_id : UUID &lt;&lt;FK&gt;&gt;\n    * transaction_id : UUID &lt;&lt;FK&gt;&gt;\n    * screening_type : ENUM(&#39;SANCTIONS&#39;,&#39;PEP&#39;,&#39;VELOCITY&#39;,&#39;THRESHOLD&#39;)\n    * risk_level : ENUM(&#39;LOW&#39;,&#39;MEDIUM&#39;,&#39;HIGH&#39;,&#39;CRITICAL&#39;)\n    * match_details : JSONB\n    * status : ENUM(&#39;PENDING&#39;,&#39;CLEARED&#39;,&#39;FLAGGED&#39;,&#39;BLOCKED&#39;)\n    * reviewed_by : UUID &lt;&lt;FK&gt;&gt;\n    * reviewed_at : TIMESTAMP\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== AUDIT (Purple) =====\nentity audit_logs #F3E5F5 {\n    * log_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n    --\n    * user_id : UUID &lt;&lt;FK&gt;&gt;\n    * action : VARCHAR(100)\n    * entity_type : VARCHAR(50)\n    * entity_id : UUID\n    * old_values : JSONB\n    * new_values : JSONB\n    * ip_address : INET\n    * user_agent : TEXT\n    * session_id : VARCHAR(255)\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== NOTIFICATIONS (Amber) =====\nentity notifications #FFF8E1 {\n    * notification_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * user_id : UUID &lt;&lt;FK&gt;&gt;\n    * type : ENUM(&#39;TRANSACTION&#39;,&#39;SECURITY&#39;,&#39;MARKETING&#39;,&#39;SYSTEM&#39;)\n    * channel : ENUM(&#39;SMS&#39;,&#39;EMAIL&#39;,&#39;PUSH&#39;,&#39;IN_APP&#39;)\n    * title : VARCHAR(255)\n    * body : TEXT\n    * data : JSONB\n    * is_read : BOOLEAN\n    * sent_at : TIMESTAMP\n    * read_at : TIMESTAMP\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== RELATIONSHIPS =====\nusers ||--o{ wallets : owns\nusers ||--o{ kyc_verifications : verifies\nusers ||--o| agents : becomes\nusers ||--o| merchants : registers_as\nusers ||--o{ audit_logs : generates\nusers ||--o{ user_sessions : has\nusers ||--o{ security_events : triggers\nusers ||--o{ scheduled_payments : creates\nusers ||--o{ disputes : raises\nusers ||--o{ notifications : receives\nusers ||--o{ aml_screenings : reviews\n\ncurrencies ||--o{ wallets : denominates\ncurrencies ||--o{ transactions : denominates\ncurrencies ||--o{ transaction_fees : denominates\ncurrencies ||--o{ commissions : denominates\ncurrencies ||--o{ agent_float_balances : denominates\ncurrencies ||--o{ scheduled_payments : denominates\n\nwallets ||--o{ transactions : sends\nwallets ||--o{ transactions : receives\nwallets ||--o{ ledger_entries : posts\nwallets ||--o{ wallet_balance_snapshots : snapshots\nwallets ||--o{ scheduled_payments : funds\n\nmerchants ||--o{ transactions : receives\n\nagents ||--o{ agents : supervises\nagents ||--o{ agent_float_balances : records\nagents ||--o{ commissions : earns\nagents ||--o{ transactions : processes\n\ntransactions ||--|| ledger_entries : splits_into\ntransactions ||--o| transaction_fees : incurs\ntransactions ||--o| commissions : generates\ntransactions ||--o| transaction_failures : may_have\ntransactions ||--o| disputes : disputed_as\ntransactions ||--o| transactions : reverses_to\ntransactions ||--o| aml_screenings : screened_by\n\nscheduled_payments ||--o{ transactions : generates\n\nnote right of transactions\n  **Critical Constraints**\n  - CHECK (amount &gt; 0)\n  - CHECK (sender_wallet_id != receiver_wallet_id)\n  - CHECK (fee_amount &gt;= 0)\n  - Partial UQ on wallets: active only\nend note\n\nnote right of ledger_entries\n  **Ledger Integrity**\n  - Every transaction produces 2+ entries\n  - SUM(debits) == SUM(credits) per txn\n  - running_balance is immutable after insert\nend note\n\nnote bottom of users\n  **Recommended Indexes**\n  - users(phone_number), users(national_id)\n  - wallets(user_id, currency_code, wallet_type)\n  - transactions(sender_wallet_id, created_at)\n  - transactions(receiver_wallet_id, created_at)\n  - transactions(idempotency_key), transactions(reference_number)\n  - transactions(external_reference), transactions(parent_transaction_id)\n  - ledger_entries(wallet_id, created_at)\n  - audit_logs(user_id, created_at), audit_logs(entity_type, entity_id)\n  - commissions(agent_id, status, created_at)\n  - disputes(transaction_id, status)\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6s9tBcq11WZ-b_-vjUx3-865">
